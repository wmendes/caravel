[Unit]
Description=Caravel sequencer (testnet)
After=network-online.target
Wants=network-online.target

[Service]
User=caravel
Group=caravel
EnvironmentFile=/opt/caravel/keys/env
Environment=RUST_LOG=info
ExecStart=/opt/caravel/bin/caravel-perps-node sequencer --config /opt/caravel/config/sequencer.toml
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/caravel/data

[Install]
WantedBy=multi-user.target
